FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/apn-renderer
COPY requirements.gateway.txt ./
RUN pip install --no-cache-dir -r requirements.gateway.txt \
 && groupadd -g 10001 apn && useradd -m -u 10001 -g 10001 apn
COPY runner.py stage_sources.py cloud_gateway.py ./
RUN chmod 0555 /opt/apn-renderer/runner.py
USER 10001:10001
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn cloud_gateway:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]